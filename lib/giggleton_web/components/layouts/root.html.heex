<!DOCTYPE html>
<html lang="en" data-theme="linen">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta :if={assigns[:page_description]} name="description" content={@page_description} />
    <.live_title default="Giggleton" suffix=" · Giggleton" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/favicon.svg"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Fira+Code:wght@400&family=Silkscreen&display=swap"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      // Linen or Midnight, chosen before first paint: the reader's stored choice, else
      // their system preference. The masthead toggle dispatches giggleton:toggle-theme.
      (() => {
        const key = "giggleton:theme";
        const root = document.documentElement;
        const dark = matchMedia("(prefers-color-scheme: dark)");
        const stored = () => { try { return localStorage.getItem(key); } catch (_) { return null; } };
        const apply = (theme) => root.setAttribute("data-theme", theme);

        apply(stored() || (dark.matches ? "midnight" : "linen"));

        window.addEventListener("giggleton:toggle-theme", () => {
          const next = root.getAttribute("data-theme") === "midnight" ? "linen" : "midnight";
          apply(next);
          try { localStorage.setItem(key, next); } catch (_) {}
        });
        window.addEventListener("storage", (e) => e.key === key && e.newValue && apply(e.newValue));
        dark.addEventListener("change", (e) => stored() || apply(e.matches ? "midnight" : "linen"));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
